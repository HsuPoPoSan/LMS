# ─────────────────────────────────────────────────────────────
# LicenseManager Pro — Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Supabase PostgreSQL Database ──────────────────────────────
#
# Find these in: Supabase Dashboard → Settings → Database
#
# Option A: Direct connection string (for local dev / long-lived servers)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Option B: Individual vars (recommended — copy from Supabase dashboard)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_SSLMODE=require

# ── Supabase SDK (only needed for Realtime / Storage / Edge) ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ── Django ────────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── License Settings ──────────────────────────────────────────
LICENSE_SALT=LMSPro-2024-SuperSecretSalt!

# ── App Settings ──────────────────────────────────────────────
APP_NAME="LicenseManager Pro"
APP_VERSION=2.0.0
HOST=0.0.0.0
PORT=8000
